# ─── Application ────────────────────────────────────────────────
APP_NAME=Tribe
# local | testing | production
APP_ENV=local
# At least 32 random characters. Signs tokens and encrypts secrets.
APP_KEY=
APP_PORT=8080
# Websites allowed to call the API from a browser (the admin panel).
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Load balancers allowed to set X-Forwarded-For (comma separated IPs/CIDRs).
# Leave empty when the API is not behind a proxy, so nobody can fake their IP.
TRUSTED_PROXIES=

# ─── MySQL (same names as Laravel) ──────────────────────────────
# The backend only ever uses the "tribe_core" database (other MAMP databases are never touched).
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=tribe_core
DB_USERNAME=
DB_PASSWORD=
# MAMP: connect through the socket file instead of host:port.
DB_SOCKET=

# ─── Redis (same names as Laravel) ──────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Rates ──────────────────────────────────────────────────────
RATE_REFRESH_SECONDS=10
RATE_STALE_SECONDS=120
QUOTE_LIFETIME_SECONDS=30
RATE_SIMULATOR_NGN_PER_USD=1540

# ─── Auth ───────────────────────────────────────────────────────
ACCESS_TOKEN_SECONDS=900
REFRESH_TOKEN_SECONDS=2592000
ADMIN_SESSION_SECONDS=43200
VERIFICATION_CODE_SECONDS=600
PIN_MAXIMUM_ATTEMPTS=5
PIN_LOCK_SECONDS=900
# Most password/PIN hashes running at once per program. Each uses 64 MB of
# memory, so 4 = at most 256 MB. Raise only on a server with more memory.
HASHING_CONCURRENCY=4

# Request bodies bigger than this are refused (413); a body must arrive in
# full within the timeout. The API trail keeps rows for this many days.
REQUEST_BODY_MAX_BYTES=262144
REQUEST_BODY_TIMEOUT_SECONDS=15
API_LOG_RETENTION_DAYS=90

# ─── Provider webhooks ──────────────────────────────────────────
# One secret per provider slug: WEBHOOK_SECRET_<SLUG in capitals, - as _>.
# Locally, simulator providers fall back to "simulator-webhook-secret".
# WEBHOOK_SECRET_GLOBAL_SIMULATOR=

# ─── Capacity (fit these to the server) ─────────────────────────
# Connections per program; server + worker + scheduler = 3x this. Keep the
# total below MySQL's max_connections (small managed MySQL plans allow ~75).
DB_MAX_OPEN_CONNECTIONS=25
DB_MAX_IDLE_CONNECTIONS=10
DB_CONNECTION_LIFETIME_SECONDS=1800
DB_CONNECTION_IDLE_SECONDS=300
# A MySQL on another server that stops answering fails requests instead of
# hanging them. (Migrations ignore the read/write timeouts.)
DB_CONNECT_TIMEOUT_SECONDS=5
DB_READ_TIMEOUT_SECONDS=60
DB_WRITE_TIMEOUT_SECONDS=30
# Soft memory limit for each Go program, in MB (0 = none). On a 4 GB droplet
# running server + worker + scheduler, about 1200 for the server.
MEMORY_LIMIT_MB=0
# Load tests on a DISPOSABLE server only: one load generator sends from one
# IP, which the per-IP limits would block. Refused when APP_ENV=production.
RATE_LIMITS_OFF=false
